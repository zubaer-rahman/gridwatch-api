NODE_ENV=development
PORT=5000
NODE_OPTIONS="--dns-result-order=ipv4first"

# Database & Cache
DATABASE_URL="postgresql://user:password@host:port/dbname?uselibpqcompat=true&sslmode=require"
REDIS_URL="rediss://default:password@host:port"

# Auth & Security
JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS=12

# Admin Seed
ADMIN_EMAIL="admin@gridwatch.com"
ADMIN_PASSWORD="Admin1234!"

# Email Service
BREVO_API_KEY="your-brevo-api-key"
EMAIL_SENDER="your-email@example.com"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# bKash Payment Gateway
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_USERNAME="your-bkash-username"
BKASH_PASSWORD="your-bkash-password"
BKASH_APP_KEY="your-bkash-app-key"
BKASH_APP_SECRET="your-bkash-app-secret"
BKASH_CALLBACK_URL="http://localhost:5000/api/v1/payments/callback"

# Frontend Client URL (for Payment Callbacks & Redirects)
CLIENT_URL="https://gridwatch-client.vercel.app"
